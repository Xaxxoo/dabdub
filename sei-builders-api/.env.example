# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
APP_NAME="SEI Builders Hub"
APP_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ─── Database ──────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=sei_builders
DB_PASSWORD=sei_builders_secret
DB_DATABASE=sei_builders_hub
DB_SCHEMA=public
DB_SSL=false
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MAX_CONNECTIONS=100

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600
REDIS_KEY_PREFIX=sei:

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_minimum_32_characters_long
JWT_REFRESH_SECRET=change_me_refresh_secret_minimum_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_COOKIE_DOMAIN=localhost
JWT_COOKIE_SECURE=false

# ─── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:3001/api/v1/auth/github/callback
GITHUB_APP_ID=your_github_app_id
GITHUB_APP_PRIVATE_KEY_PATH=./secrets/github-app.private-key.pem
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# ─── Encryption ────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=change_me_encryption_key_32_chars
ENCRYPTION_IV=change_me_iv_16ch

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ─── BullMQ ────────────────────────────────────────────────────────────────────
QUEUE_REDIS_HOST=localhost
QUEUE_REDIS_PORT=6379
QUEUE_REDIS_PASSWORD=

# ─── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=true

# ─── Swagger ───────────────────────────────────────────────────────────────────
SWAGGER_ENABLED=true
SWAGGER_TITLE="SEI Builders Hub API"
SWAGGER_DESCRIPTION="Production-grade API for the SEI Builders Hub platform"
SWAGGER_VERSION=1.0
SWAGGER_PATH=api/docs
